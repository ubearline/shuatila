{
  "name": "shuatila",
  "version": "1.1.1",
  "private": true,
  "packageManager": "pnpm@10.16.1",
  "description": "考公脑库 · Next.js 重做版 — 行测真题 + SM-2 间隔重复学习系统（Docker 可部署、GitHub CI）",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:assemble": "node scripts/assemble-db.mjs",
    "db:split": "node scripts/split-db.mjs",
    "db:import": "python scripts/parse.py",
    "db:images": "python scripts/img2webp.py",
    "db:reset": "python scripts/parse.py --fresh",
    "assets:verify": "node scripts/verify-assets.mjs",
    "sync:upstream": "node scripts/sync-upstream.mjs"
  },
  "dependencies": {
    "better-sqlite3": "^11.10.0",
    "next": "^15.1.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.10.5",
    "@types/react": "^19.0.4",
    "@types/react-dom": "^19.0.2",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["better-sqlite3", "esbuild"]
  }
}
