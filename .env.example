# ShuaTiLa 环境变量（全部可选，均有默认值，见 lib/db.ts）

# 数据根目录（默认 <工程>/data）
# DATA_DIR=./data

# 只读题库库路径（默认 <DATA_DIR>/kaogong.db）
# KAOGONG_DB_PATH=./data/kaogong.db

# 用户库路径（默认 <DATA_DIR>/users.db；Docker 中挂持久卷到 /data/users.db）
# USERS_DB_PATH=./data/users.db

# 题库图片目录（默认 <DATA_DIR>/images）
# IMAGES_DIR=./data/images

# 注册开关（默认允许，即 1）：0 / false / off / no / disabled 表示禁用注册。
# 禁用后登录页隐藏"注册"入口、后端拒绝注册与游客升级；游客匿名模式不受影响。
# ALLOW_REGISTER=1
